# Lyzr SDK Configuration
# Uses lyzr-adk SDK (version 0.1.5) for all API interactions
LYZR_API_KEY=your_lyzr_api_key_here
AGENT_ID=your_lyzr_agent_id

# Tutor agent — teaches the selected topic using a RAG knowledge base
# Falls back to AGENT_ID if not set
TUTOR_AGENT_ID=

# Evaluator agent — produces a 7-metric structured session report
EVALUATOR_AGENT_ID=

# Legacy specialist agents (no longer used — routing removed in favour of topic selector)
# ENCAPSULATION_AGENT_ID=optional_specialist_agent_id
# INHERITANCE_AGENT_ID=optional_specialist_agent_id
# POLYMORPHISM_AGENT_ID=optional_specialist_agent_id
# ABSTRACTION_AGENT_ID=optional_specialist_agent_id

# Legacy API URLs (not used — SDK handles endpoints internally)
# LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
# LYZR_TRACES_URL=https://agent-prod.studio.lyzr.ai/v3/traces
